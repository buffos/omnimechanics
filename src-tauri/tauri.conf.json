{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniMechanics",
  "version": "0.1.0",
  "identifier": "com.buffo.omnimechanics",
  "build": {
    "beforeDevCommand": "pnpm run start --port 42200",
    "devUrl": "http://localhost:42200",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist/bem-app/browser"
  },
  "app": {
    "windows": [
      {
        "title": "OmniMechanics - Advanced Structural Mechanics Platform",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}